// Prisma Schema for Smart Hostel - Intelligent Roommate Compatibility & Room Allocation System

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model College {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hostels   Hostel[]
  users     User[]
}

model Hostel {
  id         String         @id @default(uuid())
  name       String
  genderType String // "MALE", "FEMALE", "COED"
  collegeId  String
  college    College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  blocks     Block[]
  wardens    WardenHostel[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Block {
  id       String @id @default(uuid())
  name     String
  hostelId String
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  rooms    Room[]
}

model Room {
  id          String           @id @default(uuid())
  roomNumber  String
  capacity    Int              @default(2)
  blockId     String
  block       Block            @relation(fields: [blockId], references: [id], onDelete: Cascade)
  status      String           @default("AVAILABLE") // "AVAILABLE", "OCCUPIED", "PARTIALLY_OCCUPIED", "MAINTENANCE"
  isLocked    Boolean          @default(false)
  allocations RoomAllocation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([blockId, roomNumber])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String // "SUPER_ADMIN", "WARDEN", "STUDENT"
  collegeId    String?
  college      College? @relation(fields: [collegeId], references: [id])
  student      Student?
  warden       Warden?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentIdNo      String                 @unique
  firstName        String
  lastName         String
  gender           String // "MALE", "FEMALE", "OTHER"
  course           String
  branch           String
  yearOfStudy      Int
  isLocked         Boolean                @default(false)
  profile          StudentProfile?
  responses        QuestionnaireResponse?
  allocations      RoomAllocation[]
  changeRequests   RoomChangeRequest[]
  feedbacks        Feedback[]
  requestedBy      RoommatePreference[]   @relation("RequesterStudent")
  targetOfRequests RoommatePreference[]   @relation("TargetStudent")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model Warden {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  hostels   WardenHostel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WardenHostel {
  wardenId String
  hostelId String
  warden   Warden @relation(fields: [wardenId], references: [id], onDelete: Cascade)
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@id([wardenId, hostelId])
}

model StudentProfile {
  id                    String               @id @default(uuid())
  studentId             String               @unique
  student               Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sleepTimeMinutes      Int // e.g. 1380 = 23:00 (11 PM)
  wakeTimeMinutes       Int // e.g. 420 = 07:00 (7 AM)
  sleepLightSensitivity Int                  @default(3) // 1-5 scale
  cleanlinessScale      Int                  @default(3) // 1-5 scale
  cleaningFrequency     Int                  @default(3) // 1-5 scale
  noiseTolerance        Int                  @default(3) // 1-5 scale
  studyEnvironment      String // "SILENT", "MODERATE", "BACKGROUND_MUSIC"
  studyTimePreference   String // "EARLY_BIRD", "NIGHT_OWL", "FLEXIBLE"
  socialPreference      Int                  @default(3) // 1-5 scale
  visitorPreference     Int                  @default(3) // 1-5 scale
  careerGoal            String // "PLACEMENT", "HIGHER_STUDIES", "GATE_CAT", "ENTREPRENEURSHIP", "RESEARCH"
  isDataComplete        Boolean              @default(true)
  skills                StudentSkill[]
  interests             StudentInterest[]
  preferences           RoommatePreference[] @relation("RequesterProfile")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model StudentSkill {
  id               String         @id @default(uuid())
  studentProfileId String
  profile          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skillName        String
  type             String // "CAN_TEACH" or "WANTS_TO_LEARN"
}

model StudentInterest {
  id               String         @id @default(uuid())
  studentProfileId String
  profile          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  category         String // "HOBBY", "SPORT", "EXTRACURRICULAR"
  name             String
}

model RoommatePreference {
  id               String         @id @default(uuid())
  studentProfileId String
  profile          StudentProfile @relation("RequesterProfile", fields: [studentProfileId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        Student        @relation("RequesterStudent", fields: [requesterId], references: [id], onDelete: Cascade)
  targetStudentId  String
  targetStudent    Student        @relation("TargetStudent", fields: [targetStudentId], references: [id], onDelete: Cascade)
  preferenceType   String // "PREFERRED_ROOMMATE", "MUTUAL_FRIEND"
}

model Questionnaire {
  id          String     @id @default(uuid())
  title       String
  description String?
  isActive    Boolean    @default(true)
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id               String                      @id @default(uuid())
  questionnaireId  String
  questionnaire    Questionnaire               @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  category         String // Category name e.g. "DAILY_LIFESTYLE"
  questionText     String
  questionType     String // "SINGLE_CHOICE", "MULTI_CHOICE", "SCALE", "NUMERIC", "TEXT"
  weight           Float                       @default(1.0)
  isMandatory      Boolean                     @default(true)
  isHardConstraint Boolean                     @default(false)
  orderIndex       Int                         @default(0)
  options          QuestionOption[]
  responseItems    QuestionnaireResponseItem[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
}

model QuestionOption {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText  String
  optionValue String
}

model QuestionnaireResponse {
  id          String                      @id @default(uuid())
  studentId   String                      @unique
  student     Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt DateTime                    @default(now())
  isComplete  Boolean                     @default(true)
  items       QuestionnaireResponseItem[]
}

model QuestionnaireResponseItem {
  id          String                @id @default(uuid())
  responseId  String
  response    QuestionnaireResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerValue String // Stored as JSON string or plain text
}

model AllocationVersion {
  id          String             @id @default(uuid())
  versionNo   Int                @default(1)
  hostelId    String
  createdById String
  note        String?
  isFinal     Boolean            @default(false)
  createdAt   DateTime           @default(now())
  allocations RoomAllocation[]
  changes     AllocationChange[]
}

model RoomAllocation {
  id                  String            @id @default(uuid())
  allocationVersionId String
  version             AllocationVersion @relation(fields: [allocationVersionId], references: [id], onDelete: Cascade)
  roomId              String
  room                Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isLocked            Boolean           @default(false)
  compatibilityScore  Float?
  assignedAt          DateTime          @default(now())
}

model AllocationChange {
  id                  String            @id @default(uuid())
  allocationVersionId String
  version             AllocationVersion @relation(fields: [allocationVersionId], references: [id], onDelete: Cascade)
  studentId           String
  fromRoomId          String?
  toRoomId            String?
  reason              String
  changedAt           DateTime          @default(now())
}

model RoomChangeRequest {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Feedback {
  id                  String   @id @default(uuid())
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  overallRating       Int // 1 to 5
  sleepCompatibility  Int?
  studyCompatibility  Int?
  cleanlinessRating   Int?
  socialCompatibility Int?
  comments            String?
  createdAt           DateTime @default(now())
}

model SystemConfig {
  id                String   @id @default("GLOBAL")
  lifestyleWeight   Float    @default(0.30)
  academicWeight    Float    @default(0.20)
  goalsWeight       Float    @default(0.15)
  personalityWeight Float    @default(0.10)
  interestsWeight   Float    @default(0.10)
  growthWeight      Float    @default(0.10)
  mutualPrefWeight  Float    @default(0.05)
  groupAvgWeight    Float    @default(0.70)
  groupMinWeight    Float    @default(0.30)
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())
}
